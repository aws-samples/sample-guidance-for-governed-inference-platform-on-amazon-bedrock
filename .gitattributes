# Force Unix line endings on shell scripts regardless of platform git
# configuration (e.g. Windows clones with core.autocrlf=true).
# Without this, Windows-cloned repos convert these files to CRLF on
# checkout, which breaks execution on Linux/macOS with errors like
# "/bin/bash^M: bad interpreter: No such file or directory".

*.sh             text eol=lf
install.sh       text eol=lf
ccwb-install.ps1 text eol=crlf

# CloudFormation accepts templates up to 51,200 bytes inline. A CRLF checkout pushes
# otel-collector.yaml (51,181 bytes with LF) past that limit on Windows only, so the
# deploy would need the S3 artifacts bucket there and nowhere else. Keep templates LF.
deployment/infrastructure/*.yaml text eol=lf

# Binaries — never touch line endings.
*.exe   binary
*.syso  binary
*.zip   binary
*.tar   binary
*.tgz   binary
*.gz    binary
*.png   binary
*.jpg   binary
*.ico   binary

# Prebuilt Go binaries have no extension. Mark them explicitly.
source/go/prebuilt/*/credential-process-*  binary
source/go/prebuilt/*/otel-helper-*         binary

# The upstream LICENSE copy keeps upstream bytes exactly, including trailing whitespace.
# (The upstream subtrees themselves are not tracked; see scripts/fetch-claude-apps-gateway.sh.)
vendor/aws-samples/anthropic-on-aws/LICENSE -whitespace
